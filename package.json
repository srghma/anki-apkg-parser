{
  "name": "anki-apkg-parser",
  "type": "module",
  "version": "1.0.1",
  "description": "Nodejs helper for parsing Anki `.apkg` files. You can unpack the deck and get list of notes, cards, media files, models. This library uses `sqlite` as a dependency, so you can make any SQL queries yourself",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "author": "Igor Razumov",
  "license": "ISC",
  "scripts": {
    "build": "tsc && cp -r src/protos dist/",
    "test": "npm run build && ava"
  },
  "esModuleInterop": true,
  "files": [
    "dist"
  ],
  "keywords": [
    "anki",
    "apkg"
  ],
  "publishConfig": {
    "directory": "dist"
  },
  "ava": {
    "files": [
      "test/**/*.test.ts"
    ],
    "nodeArguments": [
      "--experimental-strip-types"
    ],
    "typescript": {
      "rewritePaths": {
        "src/": "dist/"
      },
      "compile": false
    }
  },
  "dependencies": {
    "@mongodb-js/zstd": "^7.0.0",
    "fs": "^0.0.1-security",
    "fstream": "^1.0.12",
    "fzstd": "^0.1.1",
    "google-proto-files": "^4.0.0",
    "mime": "^3.0.0",
    "mime-types": "^2.1.35",
    "protobufjs": "^7.2.5",
    "protocol-buffers": "^5.0.0",
    "simple-zstd": "^2.0.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6",
    "unzipit": "^1.4.3",
    "yauzl": "^3.2.0",
    "zstd-napi": "^0.0.12"
  },
  "devDependencies": {
    "@ava/typescript": "^6.0.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^18.15.11",
    "@types/unzipper": "^0.10.8",
    "@types/yauzl": "^2.10.3",
    "ava": "^6.4.1",
    "cross-env": "^7.0.3",
    "typescript": "^4.9.5"
  }
}
